<script src={{ "product-gallery.js" | asset_url }} defer></script>

<div class="main-product">
  <div class="main-product__wrapper page-width">
    <div class="main-product__media">
      {% render "product-gallery" product:product %}
    </div>

    <div class="main-product__content">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'title' %}
            <h1>{{ product.title }}</h1>

          {% when 'description' %}
            <div class="main-product__description"></div>
            
          {% when 'price' %}
            <div class="main-product__prices">
              <span class="main-product__price">{{ product.price | money }}</span>
              <span class="main-product__compare-at-price">{{ product.compare_at_price | money }}</span>
            </div>

          {% when 'variant' %}
            {% comment %} render snippet {% endcomment %}

          {% when 'add_to_cart' %}
            {% comment %} render snippet {% endcomment %}

          {% when 'faq' %}
            {% comment %} render snippet {% endcomment %}

          {% when 'stock' %}
            stock

          {% when 'divider' %}
            divider

        {% endcase %}
      {% endfor %}
    </div>
  </div>
</div>

<style>
  .main-product__wrapper{
    display: grid;
    grid-template-columns: 6fr 4fr;
    gap: 8rem;
  }

  .main-product__content{
    padding: 1rem 0;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }

  .main-product{
    padding-bottom: 4rem;
  }
</style>

{% schema %}
{
  "name": "Product",
  "settings": [],
  "blocks": [
    {
      "type": "title",
      "name":"Title",
      "limit": 1,
      "settings": []
    },
    {
      "type": "description",
      "name":"Description",
      "settings": []
    },
    {
      "type": "divider",
      "name":"Divider",
      "settings": []
    },
    {
      "type": "price",
      "name":"Price",
      "limit": 1,
      "settings": []
    },
    {
      "type": "variant",
      "name":"Variant",
      "limit": 1,
      "settings": []
    },
    {
      "type": "add_to_cart",
      "name":"Add to cart",
      "limit": 1,
      "settings": []
    },
    {
      "type": "faq",
      "name":"Faq",
      "limit": 1,
      "settings": []
    },
    {
      "type": "stock",
      "name":"Stock",
      "limit": 1,
      "settings": []
    }
  ]
}
{% endschema %}