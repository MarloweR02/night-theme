<script src={{ "product-gallery.js" | asset_url }} defer></script>

{% assign remained_price = product.compare_at_price | minus: product.price %}
{% assign discount_percent = remained_price | times: 100 |  divided_by: product.compare_at_price  %}

<div class="main-product">
  <div class="main-product__wrapper page-width">
    <div class="main-product__media">
      {% render "product-gallery" product:product %}
    </div>

    <div class="main-product__content">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'title' %}
            <h1 {{ block.shopify_attributes }}>{{ product.title }}</h1>

          {% when 'description' %}
            <div class="main-product__description" {{ block.shopify_attributes }}>{{ block.settings.description }}</div>
            
          {% when 'price' %}
            <div class="main-product__prices" {{ block.shopify_attributes }}>
              <span class="main-product__price">{{ product.price | money }}</span>
              <span class="main-product__compare-at-price">{{ product.compare_at_price | money }}</span>
              <span class="main_product__discount">- {{ discount_percent }}%</span>
            </div>

          {% when 'variant' %}
            {% comment %} render snippet {% endcomment %}

          {% when 'add_to_cart' %}
            {% comment %} render snippet {% endcomment %}

          {% when 'faq' %}
            {% comment %} render snippet {% endcomment %}

          {% when 'stock' %}
            stock

          {% when 'divider' %}
            divider

        {% endcase %}
      {% endfor %}
    </div>
  </div>
</div>

<style>
  .main-product__wrapper{
    display: grid;
    grid-template-columns: 6fr 4fr;
    gap: 8rem;
  }

  .main-product__content{
    padding: 1rem 0;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }

  .main-product{
    padding-bottom: 4rem;
  }

  .main-product__price{
    font-size: 24px;
    font-weight: bold;
    user-select: none;
  }

  .main-product__compare-at-price{
    text-decoration: line-through;
    color: gray;
    font-size: 18px;
    user-select: none;
  }

  .main_product__discount{
    font-size: 10px;
    padding: 0.4rem 1.2rem;
    line-height: 1;
    background-color: var(--primary-color);
    color: white;
    font-weight: bold;
    border-radius: 50px;
    user-select: none;
  }

  .main-product__prices{
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }
</style>

{% schema %}
{
  "name": "Product",
  "settings": [],
  "blocks": [
    {
      "type": "title",
      "name":"Title",
      "limit": 1,
      "settings": []
    },
    {
      "type": "description",
      "name":"Description",
      "settings": [
        {
          "type": "richtext",
          "id": "description",
          "label": "Description"
        }
      ]
    },
    {
      "type": "divider",
      "name":"Divider",
      "settings": []
    },
    {
      "type": "price",
      "name":"Price",
      "limit": 1,
      "settings": []
    },
    {
      "type": "variant",
      "name":"Variant",
      "limit": 1,
      "settings": []
    },
    {
      "type": "add_to_cart",
      "name":"Add to cart",
      "limit": 1,
      "settings": []
    },
    {
      "type": "faq",
      "name":"Faq",
      "limit": 1,
      "settings": []
    },
    {
      "type": "stock",
      "name":"Stock",
      "limit": 1,
      "settings": []
    }
  ]
}
{% endschema %}