<div class="featured-list-collections">
  <div class="featured-list-collections__wrapper page-width">
    <div class="featured-list-collections__head fade-in-up">
      <div class="featured-list-collections__head-content ">
        <h2 class="featured-list-collections__header">{{ section.settings.header_title }}</h2>
        <p class="featured-list-collections__description">{{ section.settings.description }}</p>
      </div>
      <a href="{{ routes.collections_url }}" class="featured-list-collections__view-all">View all collections</a>
    </div> 
    <div class="featured-list-collections__body">
      {% for collection in section.settings.collections%}
        {% render "collection-card", collection:collection %}
      {% endfor %}
    </div>
  </div>
</div>

<style>
  .featured-list-collections{
    padding: 6rem 0;
  }

  .featured-list-collections__header{
    margin-bottom: 1rem;
  }

  .featured-list-collections__wrapper{
    display: flex;
    flex-direction: column;
    gap: 4rem;
  }
  .featured-list-collections__body{
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .featured-list-collections__head{
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .featured-list-collections__view-all{
    background-color: var(--primary-color);
    color: white;
    text-decoration: none;
    padding: 1rem 2rem;
    border: 1px solid transparent;
    transition: all 0.3s ease;
  }
  
  .featured-list-collections__view-all:hover{
    background-color: white;
    color: var(--primary-color);
    border-color: var(--primary-color);
  }
</style>

{% schema %}
{
  "name": "Feature list collections",
  "settings": [
    {
      "type": "text",
      "id": "header_title",
      "label": "Title",
      "default": "A World of Premium Spices"
    },
    {
      "type": "inline_richtext",
      "id": "description",
      "label": "Description",
      "default": "Carefully sourced, richly aromatic, and crafted to elevate every dish with bold authentic flavor."
    },
    {
      "type": "collection_list",
      "id": "collections",
      "label": "Collections",
      "limit": 6
    }
  ],
  "presets": [
    {
      "name": "Feature list collections"
    }
  ]
}
{% endschema %}