<div class="hero">
  {{ section.settings.image | image_url: width: 1500 | image_tag }}
  <div class="hero__overlay"></div>
</div>

<style>
  .hero{
    width: 100%;
    height: 80vh;
    position: relative;
  }
  .hero > img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__overlay{
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: {{ section.settings.overlay_color }};
    opacity: {{ section.settings.overlay_opacity }};
  }
</style>

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "header",
      "content": "Overlay"
    },
    {
      "type": "checkbox",
      "id": "overlay_enabled",
      "label": "Enable overlay",
      "default": true
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#000",
      "visible_if": "{{ section.settings.overlay_enabled }}"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 1,
      "step": 0.1,
      "default": 0.7,
      "visible_if": "{{ section.settings.overlay_enabled }}"
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}