<div class="featured-collection ">
  <div class="featured-collection__wrapper page-width">
    <div class="featured-collection__header ">
    <h2 class="featured-collection__header-title">{{ section.settings.title }}</h2>
    <p class="featured-collection__header-description">{{ section.settings.description }}</p>
  </div>
  <div class="featured-collection__body">
    {% for product in section.settings.collection.products limit: 4 %}
      {% render "product-card", product: product %}
    {% endfor %}
  </div>
  </div>
</div>



<style>
  .featured-collection {
      background-color: whitesmoke;
    }

  /* Desktop styles */
  @media (min-width: 1025px) {
    .featured-collection{
      padding: 6rem 0;
    }

    .featured-collection__body{
      display: grid;
      grid-template-columns: repeat(4,1fr);
      gap: 2rem;
    }
  }

  /* Tablet styles */
  @media (min-width: 768px) and (max-width: 1024px) {
    .featured-collection{
      padding: 6rem 0;
    }

    .featured-collection__body{
      display: grid;
      grid-template-columns: repeat(4,1fr);
      gap: 2rem;
    }
  }

  /* Mobile styles */
  @media (max-width: 767px) {
    .featured-collection{
      padding: 6rem 0;
    }

    .featured-collection__body{
      display: grid;
      grid-template-columns: repeat(2,1fr);
      gap: 1rem;
    }
  }
</style>


{% schema %}
{
  "name": "Featured collection",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title"
    },
    {
      "type": "inline_richtext",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Featured collection"
    }
  ],
  "presets": [
    {
      "name": "Featured collection"
    }
  ]
}
{% endschema %}