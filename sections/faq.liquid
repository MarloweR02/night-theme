<div class="faq">
  <div class="faq__wrapper page-width">
    <div class="faq__header">
      <h2 class="faq__heading fade-in-up">{{ section.settings.title }}</h2>
      <p class="faq__description fade-in-up">{{ section.settings.description }}</p>
    </div>
    <div class="faq__body">
      {% for block in section.blocks %}
        <div class="accordion-item fade-in-up" {{ block.shopify_attributes }}>
          <input type="checkbox" id="accordion-{{ forloop.index }}" class="accordion-checkbox">
          <label for="accordion-{{ forloop.index }}" class="accordion-question"> {{ block.settings.question }}</label>
          <div class="accordion-answer__container">
            <div class="accordion-answer">{{ block.settings.answer }}</div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

<style>

  .faq {
    padding: 6rem 0;
  }

  .faq__header{
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .faq__wrapper {
    display: flex;
    flex-direction: column;
    gap: 4rem;
  }

  .faq__body {
    display: flex;
    gap: 1rem;
    flex-direction: column;
  }

  .accordion-checkbox{
    display: none;
  }

  .accordion-answer__container{
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.3s ease, padding-top 0.3s ease;
  }

  .accordion-answer {
    overflow: hidden;
    min-height: 0;
    color: rgb(62, 62, 62);
  }

  .accordion-checkbox:checked ~ .accordion-answer__container{
    grid-template-rows: 1fr;
    padding-top: 1rem;
  }

  .faq__accordion {
    border: 1px solid black;
    padding: 1rem;
    user-select: none;
  }

  .accordion-item{
    border: 1px solid black;
    border-radius: 0.4rem;
    padding: 1rem;
  }

  .accordion-question{
    cursor: pointer;
    width: 100%;
    display: block;
    font-size: 20px;
  }
  
  .accordion-question:hover{
    text-decoration: underline;
  }

  


</style>

{% schema %}
  {
    "name": "FAQ",
    "settings": [
      {
        "type": "text",
        "id": "title",
        "label": "Title",
        "default": "Frequently Asked Questions"
      }, {
        "type": "inline_richtext",
        "id": "description",
        "label": "Description",
        "default": "Find answers to the most common questions about our products, shipping, and returns."
      }
    ],
    "blocks": [
      {
        "type": "accordion",
        "name": "Accordion",
        "settings": [
          {
            "type": "text",
            "id": "question",
            "label": "Question",
            "default": "How long does shipping take?"
          }, {
            "type": "inline_richtext",
            "id": "answer",
            "label": "Answer",
            "default": "Shipping typically takes 3–7 business days depending on your location. You will receive a tracking link once your order has been shipped."
          }
        ]
      }
    ],
    "presets": [
  {
    "name": "FAQ",
    "blocks": [
      {
        "type": "accordion",
        "settings": {
          "question": "How long does shipping take?",
          "answer": "Shipping typically takes 3–7 business days depending on your location. You will receive a tracking link once your order has been shipped."
        }
      },
      {
        "type": "accordion",
        "settings": {
          "question": "Do you offer international shipping?",
          "answer": "Yes, we ship worldwide. Shipping times and costs may vary depending on your location."
        }
      },
      {
        "type": "accordion",
        "settings": {
          "question": "Can I return my order?",
          "answer": "Yes, we offer a 30-day return policy. Items must be unused and in their original packaging."
        }
      },
      {
        "type": "accordion",
        "settings": {
          "question": "How can I track my order?",
          "answer": "Once your order is shipped, you will receive an email with a tracking link to monitor your delivery."
        }
      }
    ]
  }
]
  }
{% endschema %}