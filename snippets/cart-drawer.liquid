<cart-drawer class="cart-drawer" open>
  <div class="cart-drawer__overlay"></div>
  <div class="cart-drawer__main">
    <div class="cart-drawer__main-header">
      <h4>Shopping cart({{ cart.item_count }})</h4>
      <div class="svg-wrapper cart-close-trigger">
        {{ "icon-x-mark.svg" | inline_asset_content }}
      </div>
    </div>
    <div class="cart-drawer__main-body">
      {% for item in cart.items %}
        <div class="cart-drawer__item">
          <div class="cart-item__image">
            {{ item.image |  image_url: width: 300 |  image_tag  }}
          </div>
          <div class="cart-item__content">
            <div class="cart-item__header">
              <h2 class="cart-item__title">{{ item.title }}</h2>
            </div>
            <div class="cart-item__footer">
              <div class="cart-item__prices">
                <span class="cart-item__price">{{ item.price | money }}</span>
              </div>
              {% render "cart-actions" cart_item:item, line_index: forloop.index %}
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
    <div class="cart-drawer__main-footer">dsa</div>
  </div>
</cart-drawer>

<style>
  .cart-drawer__overlay{
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    background-color: black;
    opacity: 0;
    z-index: 998;
    pointer-events: none;
    transition: opacity 0.3s ease-out;
  }

  cart-drawer[open] .cart-drawer__overlay{
    opacity: 0.8;
    pointer-events: all;
  }

  .cart-item__header{
    padding-top: 0.4rem;
  }
  
  .cart-drawer__main{
    position: fixed;
    top: 0;
    right: -100%;
    max-width: 450px;
    height: 100vh;
    width: 100%;
    background-color: white;
    z-index: 999;
    transition: right 0.3s ease;
    display: flex;
    flex-direction: column;
    will-change: right;
  }
  
  cart-drawer[open] .cart-drawer__main{
    right: 0;
  }

  .cart-drawer__main-header{
    padding: 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid rgb(195, 195, 195);
  }

  .cart-drawer__item{
    display: flex;
    gap: 0.8rem;
  }

  .cart-drawer__main-body{
    display: flex;
    flex-direction: column;
    gap: 1.6rem;
    flex: 1;
    padding: 0 2rem;
    overflow-x: auto;
  }

  .cart-item__image{
    width: 120px;
    height: auto;
  }
  .cart-item__image > img{
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cart-item__title{
    font-size: 16px;
    line-height: 1.2;
    color: rgb(72, 72, 72);
  }

  .cart-item__content{
    display: flex;
    width: 100%;
    flex-direction: column;
    justify-content: space-between;
  }

  .cart-item__footer{
    display: flex;
    justify-content: space-between;
    padding-bottom: 0.4rem ;
  }

  .cart-drawer__main-footer{
    width: 100%;
    height: 70px;
    background-color: rgb(223, 223, 223);
    padding: 2rem;
  }

  .cart-item__price{
    font-size: 14px;
    font-weight: bold;
    line-height: 1;
  }
  
</style>