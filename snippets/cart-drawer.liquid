<cart-drawer class="cart-drawer" open>
  <div class="cart-drawer__overlay"></div>
  <div class="cart-drawer__main">
    <div class="cart-drawer__main-header">
      <h4>Shopping cart({{ cart.item_count }})</h4>
      <div class="svg-wrapper cart-close-trigger">
        {{ "icon-x-mark.svg" | inline_asset_content }}
      </div>
    </div>
    <div class="cart-drawer__main-body"></div>
    <div class="cart-drawer__main-footer"></div>
  </div>
</cart-drawer>

<style>
  .cart-drawer__overlay{
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    background-color: black;
    opacity: 0;
    z-index: 998;
    pointer-events: none;
    transition: opacity 0.3s ease-out;
  }

  cart-drawer[open] .cart-drawer__overlay{
    opacity: 0.8;
    pointer-events: all;
  }
  
  .cart-drawer__main{
    position: fixed;
    top: 0;
    right: -100%;
    max-width: 400px;
    height: 100vh;
    width: 100%;
    background-color: white;
    z-index: 999;
    transition: right 0.3s ease-out;
  }
  
  cart-drawer[open] .cart-drawer__main{
    right: 0;
  }

  .cart-drawer__main-header{
    padding: 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
</style>