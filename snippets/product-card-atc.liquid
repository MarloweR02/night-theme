<product-card-atc class="product-card-atc">
  {% form 'product', product %}
    <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
    <input type="hidden" name="quantity" value="0">
    <button class="product-card-atc__button">
      Add to cart 
    </button>
  {% endform %}
</product-card-atc>

<style>
  .product-card-atc{
    position: absolute;
    left: 0;
    bottom: -100%;
    width: 100%;
    padding: 1rem;
    transition: all 0.3s ease;
  }

  .product-card-atc__button{
    background-color: transparent;
    color: white;
    border: 1px solid white;
    width: 100%;
    padding: 0.8rem 0;
    width: 100%;
    border-radius: 100px;
    cursor: pointer;
    transition: all 0.3s ease;
    font-weight: bold;
  }
  .product-card-atc__button:hover{
    background-color: white;
    color: black;
  }
</style>