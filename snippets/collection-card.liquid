<a href="{{ collection.url }}">
  <div class="collection-card fade-in-up">
  {{ collection.featured_image |  image_url: width: 700 | image_tag  }}
  <div class="collection-card__overlay-content">
    <h3 class="collection-card__overlay-content__title">{{ collection.title }}</h3>
  </div>
</div>
</a>

<style>
  .collection-card{
    width: 100%;
    height: 100%;
    position: relative;
    cursor: pointer;
    overflow: hidden;
  }
  .collection-card > img {
    width: 100%;
    height: 100%;
    transition: transform 0.3s ease;
  }
  .collection-card:hover > img {
    transform: scale(1.03);
  }

  .collection-card__overlay-content{
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    padding:  2rem;
    z-index: 2;
    color: white;
    background: linear-gradient(
    to bottom,
    rgba(0, 0, 0, 0) 0%,
    rgba(0, 0, 0, 0.8) 40%,
    rgba(0, 0, 0, 1) 100%
  );
  }
</style>